<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_bringup</name>
  <version>0.1.0</version>
  <description>Launch files that bring up PX4 SITL + Gazebo + uXRCE-DDS agent and the ISE-drone ROS 2 stack.</description>
  <maintainer email="drknu12@gmail.com">ISE-drone</maintainer>
  <license>MIT</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>px4_bridge</exec_depend>
  <exec_depend>sensor_adapter</exec_depend>
  <exec_depend>drone_slam</exec_depend>
  <exec_depend>object_detector</exec_depend>
  <exec_depend>object_tracker</exec_depend>
  <exec_depend>semantic_mapper</exec_depend>
  <exec_depend>semantic_database</exec_depend>
  <exec_depend>mission_manager</exec_depend>
  <exec_depend>llm_interface</exec_depend>
  <exec_depend>system_monitor</exec_depend>
  <exec_depend>exploration</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
