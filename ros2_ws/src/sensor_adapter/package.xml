<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_adapter</name>
  <version>0.1.0</version>
  <description>Common sensor topics (/camera/*) from Gazebo (ros_gz_bridge) or real cameras. Phase 3.</description>
  <maintainer email="drknu12@gmail.com">ISE-drone</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_image</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
